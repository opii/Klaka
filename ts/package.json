{
  "name": "@klaka/client",
  "version": "0.1.0",
  "private": true,
  "description": "Senzor u browseru: događaji, token pregleda, honeypot. Bez logike odlučivanja.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --format=iife --global-name=klaka --target=es2017 --outfile=dist/klaka.min.js && esbuild src/index.ts --bundle --format=esm --target=es2017 --outfile=dist/klaka.esm.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=dist-test --log-level=warning && node --test \"dist-test/*.test.js\"",
    "size": "gzip -9c dist/klaka.min.js | wc -c"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
