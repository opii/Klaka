# Kopirati u .env i promeniti. Bez .env važe razvojne vrednosti iz docker-compose.yaml.
POSTGRES_USER=ppd
POSTGRES_PASSWORD=ppd-dev
POSTGRES_DB=ppd
# Razvojni alati rade pod ovim korisnikom, da fajlovi na hostu ne budu root-ovi.
UID=1000
GID=1000
# Portovi na hostu (unutar Docker mreže su standardni).
POSTGRES_PORT=15432
VALKEY_PORT=16379
COLLECTOR_PORT=18080
API_PORT=18081
OLLAMA_PORT=18434
# Lokalni modeli (Ollama, po imenu iz ollama.com/library). Vidi docs/llm.md.
PPD_LLM_MODEL=gemma3:4b
PPD_EMBED_MODEL=bge-m3
