# Kopirati u .env i promeniti. Bez .env važe razvojne vrednosti iz docker-compose.yaml.
POSTGRES_USER=klaka
POSTGRES_PASSWORD=klaka-dev
POSTGRES_DB=klaka
# Razvojni alati rade pod ovim korisnikom, da fajlovi na hostu ne budu root-ovi.
UID=1000
GID=1000
# Portovi na hostu (unutar Docker mreže su standardni).
POSTGRES_PORT=15432
VALKEY_PORT=16379
COLLECTOR_PORT=18080
API_PORT=18081
DEMO_PORT=18082
REVIEW_PORT=18083
OLLAMA_PORT=18434
# Lokalni modeli (Ollama, po imenu iz ollama.com/library). Vidi docs/llm.md.
KLAKA_LLM_MODEL=gemma3:4b
# Opis kohorte za recenzenta: gemma3:12b je izabran merenjem (docs/llm.md §7) — ~8 GB, na CPU-u
# ~70 s po kohorti, u pozadini. gemma3:4b je brži i slabiji (loše broji, greši u ironiji).
KLAKA_DESCRIBE_MODEL=gemma3:12b
KLAKA_EMBED_MODEL=bge-m3
# klaka-api: izdavanje tokena. Bez KLAKA_SIGNING_SEED ključ je privremen (ne preživljava restart).
# Seed = base64url od 32 nasumična bajta, npr.: node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
KLAKA_PORTALS=demo.local
KLAKA_SIGNING_KID=dev-1
KLAKA_SIGNING_SEED=
# klaka-api: UI recenzenta (http://localhost:18083), recenzenti `ime:token` odvojeni zarezom,
# token ≥ 16 znakova. Prazno = UI isključen. Token npr.: openssl rand -base64 18
KLAKA_REVIEW_TOKENS=
# klaka-collector: API ključevi portala za /v1/ingest (portal=ključ, odvojeni zarezom) i retencija događaja.
KLAKA_API_KEYS=demo.local=dev-api-key
KLAKA_RETENTION_DAYS=30
